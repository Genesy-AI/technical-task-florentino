# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server and MongoDB (Preview).
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://root:password@localhost:3306/express?schema=public"

# Phone enrichment provider rate limits (p-throttle, per provider)
PHONE_PROVIDER_ORION_LIMIT=2
PHONE_PROVIDER_ORION_INTERVAL_MS=1000
PHONE_PROVIDER_ASTRA_LIMIT=10
PHONE_PROVIDER_ASTRA_INTERVAL_MS=1000
PHONE_PROVIDER_NIMBUS_LIMIT=5
PHONE_PROVIDER_NIMBUS_INTERVAL_MS=1000

# Batch workflow starts when enriching multiple leads
PHONE_ENRICH_BATCH_SIZE=5
PHONE_ENRICH_BATCH_INTERVAL_MS=1000
